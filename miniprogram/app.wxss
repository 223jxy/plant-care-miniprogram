page {
  min-height: 100vh;
  background: #f6faf7;
  color: #1d2939;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
}

.card {
  border: 1rpx solid #e4e7ec;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(16, 24, 40, 0.05);
}

.muted {
  color: #667085;
}

.primary-text {
  color: #2e7d32;
}

.warning-text {
  color: #b54708;
}

.danger-text {
  color: #b42318;
}

.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
