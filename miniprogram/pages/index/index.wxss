.dashboard-hero {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 36rpx;
  border: 1rpx solid #e4e7ec;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(16, 24, 40, 0.05);
}

.hero-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.device-space,
.freshness {
  color: #667085;
  font-size: 24rpx;
}

.device-status {
  min-width: 88rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
}

.device-status-online {
  background: #eaf6ee;
  color: #2e7d32;
}

.device-status-offline {
  background: #f2f4f7;
  color: #667085;
}

.device-name {
  color: #1d2939;
  font-size: 40rpx;
  font-weight: 700;
}

.health-row {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-top: 10rpx;
}

.health-score {
  display: flex;
  align-items: baseline;
  justify-content: center;
  width: 156rpx;
  height: 156rpx;
  border: 10rpx solid #66bb6a;
  border-radius: 50%;
  color: #2e7d32;
}

.score-number {
  font-size: 56rpx;
  font-weight: 800;
}

.score-unit {
  margin-left: 4rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.health-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 10rpx;
}

.health-label {
  color: #667085;
  font-size: 28rpx;
}

.health-level {
  font-size: 34rpx;
  font-weight: 700;
}

.health-level-success {
  color: #2e7d32;
}

.health-level-normal {
  color: #29b6f6;
}

.health-level-warning {
  color: #b54708;
}

.health-level-danger {
  color: #b42318;
}

.health-level-muted {
  color: #667085;
}

.offline-banner {
  padding: 18rpx 20rpx;
  border: 1rpx solid #d0d5dd;
  border-radius: 14rpx;
  background: #f9fafb;
  color: #475467;
  font-size: 25rpx;
  line-height: 1.45;
}

.diagnosis-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 78rpx;
  margin-top: 4rpx;
  border: 1rpx solid #66bb6a;
  border-radius: 14rpx;
  background: #ffffff;
  color: #2e7d32;
  font-size: 28rpx;
  font-weight: 700;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
  margin-top: 24rpx;
}

.metric-card {
  display: flex;
  min-height: 156rpx;
  flex-direction: column;
  justify-content: space-between;
  padding: 26rpx;
  border: 1rpx solid #e4e7ec;
  border-radius: 16rpx;
  background: #ffffff;
}

.metric-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.metric-label {
  color: #667085;
  font-size: 24rpx;
}

.metric-status {
  min-width: 68rpx;
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 21rpx;
  font-weight: 700;
}

.metric-status-success {
  background: #eaf6ee;
  color: #2e7d32;
}

.metric-status-warning {
  background: #fff8e8;
  color: #b54708;
}

.metric-status-muted {
  background: #f2f4f7;
  color: #667085;
}

.metric-value-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.metric-value {
  color: #1d2939;
  font-size: 40rpx;
  font-weight: 800;
}

.metric-unit {
  color: #667085;
  font-size: 22rpx;
  font-weight: 600;
}
